####################################################################
# 个人知识库系统环境变量清单（SiYuan + AnythingLLM + Ollama）
# 文件位置：与 docker-compose.yml 同目录
# 生成密钥：openssl rand -hex 32  或  openssl rand -base64 24
####################################################################

# ============ [必填] 通用 ============

# 宿主机上存放所有持久化数据的根目录（脚本 init.sh 也会用到）
DATA_ROOT=/srv/kb

# 你现有的零散项目文件夹（源码）绝对路径 —— 只会被【只读】挂载
REPOS_DIR=/srv/repos

# 宿主机用户 UID/GID（Linux 下用 `id -u` / `id -g` 查）
# SiYuan 与 AnythingLLM 容器内部进程都以这个身份运行，
# 必须与数据目录属主一致，否则出现 Permission denied
PUID=1000
PGID=1000

# ============ [必填] SiYuan ============

# SiYuan 锁屏密码（浏览器访问时输入）。【务必修改】
# 要求 6 位以上，太短容器会启动失败
SIYUAN_ACCESS_AUTH_CODE=<YOUR_SIYUAN_PASSWORD_HERE>

# ============ [必填] AnythingLLM ============

# 容器内固定路径，不要改
STORAGE_DIR=/app/server/storage
SERVER_PORT=3001

# API 签名密钥（>=32 字符随机串），保护上传文档在磁盘上的加密
SIG_KEY=<GENERATE_WITH:openssl_rand_hex_32>
SIG_SALT=<GENERATE_WITH:openssl_rand_hex_32>

# ---------- LLM：Ollama（容器网络内地址） ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_PATH=http://ollama:11434
# 与 `ollama pull` 的模型 tag 完全一致
OLLAMA_MODEL_PREF=qwen3:8b      # 按显存选择：8b / 14b / 32b
OLLAMA_MODEL_TOKEN_LIMIT=32768
# 慢速 CPU 推理时防止长回答被中断（毫秒）
OLLAMA_RESPONSE_TIMEOUT=12000000

# ---------- Embedding：同样走 Ollama ----------
EMBEDDING_ENGINE=ollama
EMBEDDING_BASE_PATH=http://ollama:11434
EMBEDDING_MODEL_PREF=bge-m3:latest
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=8192

# ---------- 向量数据库：默认 LanceDB，零依赖 ----------
VECTOR_DB=lancedb

# ---------- 远程访问时强制的应用密码 ----------
# 【若通过公网反代暴露，必填】；纯内网用可留空注释掉
# JWT_SECRET 在启用多用户模式后必填（>=12 字符）
AUTH_TOKEN=<YOUR_ANYTHINGLLM_API_PASSWORD_HERE>
JWT_SECRET=<GENERATE_WITH:openssl_rand_hex_24>
JWT_EXPIRY=30d

# ============ [选填] Ollama ============

# 模型拉取走代理时取消注释（很多模型在国内网络需要）
# HTTPS_PROXY=http://192.168.1.10:7890

# 保持模型常驻显存，避免每次问答冷启动（按显卡显存量力而行）
OLLAMA_KEEP_ALIVE=30m

# ============ [选填] Cloudflare Tunnel（docker compose --profile cf） ============

# Zero Trust 面板 → Networks → Tunnels → 创建 Tunnel 后复制的 Token
# 不启用隧道方案就留空
CLOUDFLARE_TOKEN=<YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE>

# ============ [选填] Tailscale（docker compose --profile ts） ============

# 生成地址：https://login.tailscale.com/admin/settings/keys （建议勾选 Reusable）
# 留空则容器首次启动时从日志里拿登录 URL 手动授权
TS_AUTHKEY=<YOUR_TAILSCALE_AUTH_KEY_HERE>
# 节点名（tailnet 内显示的主机名）
TS_HOSTNAME=kb-server
# 可选：通告内网子网路由（如 192.168.1.0/24），让外出时通过 tailnet 访问家里整个网段
# 通告后需在 Tailscale 管理台 approve 该 route
TS_ROUTES=
# 默认通告为出口节点（--advertise-exit-node）；同样需在管理台 approve
# 如不想当出口节点可留空此变量
TS_EXTRA_ARGS=--advertise-exit-node
